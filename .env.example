# ===== TELEGRAM BOT SETTINGS =====
# Получи у @BotFather
BOT_TOKEN=your_bot_token_here

# ===== DATABASE SETTINGS (PostgreSQL) =====
# Для локальной разработки с Docker
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=postres_db
DB_HOST=localhost
DB_PORT=5432

# Полный URL для SQLAlchemy (asyncpg)
DATABASE_URL=postgresql+asyncpg://sysdba:masterkey@localhost:5433/movie_bot_db

# ===== KINOPOISK API SETTINGS =====
# Получи на https://poiskkino.ru/
KINOPOISK_API_KEY=your_kinopoisk_api_key_here

# API эндпоинты (обычно не меняются)
KINOPOISK_API_URL=https://api.poiskkino.dev/v1.4/
KINOPOISK_ALT_API_URL=https://api.poiskkino.dev/v1/

# Заглушка для отсутствующих постеров
POSTER_PLACEHOLDER_URL=https://via.placeholder.com/600x900/333333/FFFFFF?text=No+Poster.jpg
